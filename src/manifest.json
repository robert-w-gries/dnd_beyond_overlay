{
  "manifest_version": 2,
  "name": "DnD Beyond Overlay",
  "author": "Rob Gries",
  "version": "0.1.0",
  "description": "Use the power of DnD Beyond from the comfort of your Roll20 session.",
  "icons": {
    "16": "./icons/icon16.png",
    "48": "./icons/icon48.png",
    "128": "./icons/icon128.png"
  },
  "background": {
    "persistent": false,
    "scripts": ["./background.js"]
  },
  "browser_action": {
    "default_icon": "./icons/icon16.png"
  },
  "content_scripts": [{
    "matches": ["*://app.roll20.net/editor/"],
    "js": ["./receiver/roll20.js"]
  }],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "web_accessible_resources": ["./index.html", "./inject_sidebar.js"],
  "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'"
}